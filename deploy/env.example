# AniTether production settings. Copy to `.env` in the repo root and fill in:
#   cp deploy/env.example .env
# docker-compose.prod.yml reads it automatically. Never commit the real `.env`.
#
# Passwords go into a Postgres connection string: use letters and digits only
# (e.g. `openssl rand -hex 24`) — `;` or `=` would break the string.

# --- Database -------------------------------------------------------------------------
# Four separate passwords, one per role (generate each with `openssl rand -hex 24`):
#   POSTGRES_PASSWORD   the image's superuser — only used inside the db container
#                       (first-start setup, scripts/restore.sh). Nothing connects as it.
#   OWNER_DB_PASSWORD   anitether_owner — owns the schema; used only by the one-shot
#                       `migrate` service.
#   APP_DB_PASSWORD     anitether_app — what the API runs as: rows only, no DDL.
#   BACKUP_DB_PASSWORD  anitether_backup — read-only, for the daily dump.
# The roles are created on the database's FIRST start; changing a password later also
# needs `ALTER ROLE <role> PASSWORD '...'` (docs/self-hosting.md, Troubleshooting).
POSTGRES_PASSWORD=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
BACKUP_DB_PASSWORD=
POSTGRES_DB=anitether

# --- First admin ------------------------------------------------------------------------
# Created on startup only while no Admin exists. Log in, then clear the password here and
# `docker compose -f docker-compose.prod.yml up -d` again.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Network ----------------------------------------------------------------------------
# Where the API listens on the host. Keep 127.0.0.1 (tunnel, or a reverse proxy on this
# host). 0.0.0.0 opens it to the LAN over plain http, where login does NOT work: the auth
# cookie is HTTPS-only outside localhost. For LAN access put an HTTPS proxy in front.
API_BIND=127.0.0.1
API_PORT=8080
# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → Docker).
# Only used with `--profile tunnel`.
TUNNEL_TOKEN=
# Who may tell the API the real client IP (CIDR list). Default: the cloudflared container.
# Reverse proxy on the host instead: the Docker gateway, 172.28.0.1/32.
TRUSTED_PROXY_NETWORKS=172.28.0.10/32
# Header with the client IP. X-Forwarded-For works for the tunnel. Behind Cloudflare
# with your own reverse proxy use CF-Connecting-IP (see docs/self-hosting.md first).
CLIENT_IP_HEADER=X-Forwarded-For

# --- Backups ----------------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# --- Source health checks + email alerts (optional) ------------------------------------
HEALTH_CHECKS_ENABLED=true
# Leave SMTP_HOST empty to skip emails (problems are still logged).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
